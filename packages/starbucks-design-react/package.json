{
  "name": "@sbux/starbucks-design-react",
  "version": "1.1.22",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.es.js",
      "require": "./dist/icon.cjs"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.es.js",
      "require": "./dist/locale.cjs"
    },
    "./pro": {
      "types": "./dist/pro/index.d.ts",
      "import": "./dist/pro.es.js",
      "require": "./dist/pro.cjs.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build -c vite.config.umd.ts && node scripts/build-shims.mjs",
    "build:starter-runtime": "node scripts/build-starter-runtime.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@arco-design/web-react": ">=2.63.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^29.1.1",
    "less": "^4.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^4.1.10"
  }
}
