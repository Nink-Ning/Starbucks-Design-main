{
  "name": "@sbux/starbucks-design-vue",
  "version": "1.1.20",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.mjs",
      "require": "./dist/icon.cjs"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.mjs",
      "require": "./dist/locale.cjs"
    },
    "./pro": {
      "types": "./dist/pro/index.d.ts",
      "import": "./dist/pro.es.js",
      "require": "./dist/pro.cjs.js"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build && vite build -c vite.config.umd.ts && node scripts/build-shims.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@arco-design/web-vue": ">=2.57.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "less": "^4.6.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
