---
/**
 * Corner-radius specimens for the Foundations / Radius page. Each cell shows a
 * brand-tinted square rounded to the token's value, with its name, px value and
 * usage. Click copies the px value.
 */
interface Item {
  name: string;
  value: number;
  note?: string;
}
const { items } = Astro.props as { items: Item[] };
---

<div class="fs-radius not-content">
  {
    items.map((it) => (
      <button
        class="fs-radius-cell"
        type="button"
        data-copy={`${it.value}px`}
        title={`点击复制 ${it.value}px`}
      >
        <span class="fs-radius-box" style={`border-radius:${it.value}px`} />
        <span class="fs-radius-name">{it.name}</span>
        <span class="fs-radius-val">
          {it.value}px{it.note ? ` · ${it.note}` : ''}
        </span>
      </button>
    ))
  }
</div>

<style>
  .fs-radius {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.7rem;
    margin: 1rem 0 1.75rem;
  }
  .fs-radius-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-bg);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition: border-color 0.12s ease;
  }
  .fs-radius-cell:hover {
    border-color: var(--sl-color-text-accent);
  }
  .fs-radius-cell:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .fs-radius-box {
    width: 100%;
    height: 72px;
    margin-bottom: 0.5rem;
    background: var(--sl-color-accent-low);
    border: 1.5px solid var(--sl-color-text-accent);
    /* Only round the top-left + top-right so the radius reads clearly against
       the square bottom edge. */
    border-bottom-left-radius: 0 !important;
    border-bottom-right-radius: 0 !important;
  }
  .fs-radius-name {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .fs-radius-val {
    font-size: 0.74rem;
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
  .fs-radius-cell.copied .fs-radius-val::after {
    content: ' ✓';
    color: var(--sl-color-text-accent);
  }
</style>

<script>
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.fs-radius-cell');
    if (!btn?.dataset.copy) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy);
      btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 1400);
    } catch {}
  });
</script>
