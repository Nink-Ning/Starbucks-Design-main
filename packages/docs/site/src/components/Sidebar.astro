---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
const isGuideSection = Astro.url.pathname.includes('/guide/');
const shouldRenderSearch =
  !isGuideSection &&
  (config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro');
---

{shouldRenderSearch && <div class="sb-sidebar-search"><Search /></div>}
{!shouldRenderSearch && <div class="sb-sidebar-leading-space" aria-hidden="true"></div>}

<SidebarPersister>
  <SidebarSublist sublist={sidebar} />
</SidebarPersister>

<script is:inline>
  (function () {
    var savedScrollTop;
    var savedSection;

    function getSidebarSection() {
      var path = location.pathname;
      if (path.indexOf('/components/') > -1) return 'components';
      if (path.indexOf('/templates/') > -1) return 'templates';
      if (path.indexOf('/business-components/') > -1) return 'business';
      if (path.indexOf('/guide/ai-skills/') > -1) return 'skills';
      return 'global';
    }

    function restoreSavedSidebarScroll() {
      var scroller = document.getElementById('starlight__sidebar');
      if (scroller && savedSection === getSidebarSection() && savedScrollTop !== undefined) {
        scroller.scrollTop = savedScrollTop;
      }
    }

    document.addEventListener('astro:before-swap', function () {
      var scroller = document.getElementById('starlight__sidebar');
      if (!scroller || !matchMedia('(min-width: 50rem)').matches) return;
      savedScrollTop = scroller.scrollTop;
      savedSection = document.documentElement.dataset.docsSection || getSidebarSection();
    });

    document.addEventListener('astro:after-swap', function () {
      restoreSavedSidebarScroll();
    });

    document.addEventListener('astro:page-load', function () {
      restoreSavedSidebarScroll();
      savedScrollTop = undefined;
      savedSection = undefined;
    });
  })();
</script>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
